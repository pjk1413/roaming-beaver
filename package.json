{
  "name": "mystery-trips",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @mystery-trips/db generate",
    "db:migrate": "pnpm --filter @mystery-trips/db migrate",
    "db:seed": "pnpm --filter @mystery-trips/db seed",
    "db:push": "pnpm --filter @mystery-trips/db push",
    "airports:sync": "node scripts/sync-airports.mjs",
    "profile-destination": "pnpm --filter @mystery-trips/api profile",
    "discover-destinations": "pnpm --filter @mystery-trips/api discover",
    "refresh-destination-profiles": "pnpm --filter @mystery-trips/api refresh-profiles"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}

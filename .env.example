# App data — local Postgres in dev, Supabase Postgres connection string in prod
DATABASE_URL=postgresql://patrick@localhost:5432/roaming-beaver

# Supabase Auth (+ hosted Postgres in production)
# Create a project at https://supabase.com — use its URL/keys even in local
# development if you want OAuth. For fully local Auth+DB, run `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Enable providers in Supabase Dashboard → Authentication → Providers
# (Google, GitHub, etc.) and set redirect URL:
#   http://localhost:3000/auth/callback
#   https://YOUR_DOMAIN/auth/callback

DUFFEL_API_KEY=
# Hotel search/pricing/booking — sandbox key needs no card; production key
# requires adding a card in the LiteAPI dashboard (Nuitée Connect).
LITEAPI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Live web search for profile/discovery research (preferred over DuckDuckGo Instant Answer)
# https://tavily.com — free tier works; without this we fall back to DDG Instant Answer
TAVILY_API_KEY=

# Comma-separated emails allowed into /admin/destinations (single-operator).
ADMIN_EMAILS=

# Discovery job tunables (Cloud Run Jobs: discover-destinations / refresh-destination-profiles)
MAX_NEW_DESTINATIONS_PER_RUN=12
DISCOVER_ACCESS_PASS_RATE=0.65
DISCOVER_MIN_ATTRACTIONS=6
PROFILE_REFRESH_AFTER_DAYS=90
# Matching: exclude destinations closer than this to the origin airport
MIN_DESTINATION_DISTANCE_MILES=250
# Profile + hotel search: max neighborhoods per destination
MAX_STAY_AREAS=5
# Destination photo gallery filled on profile/refresh (Wikipedia/Commons + optional Unsplash)
MAX_DESTINATION_IMAGES=8
# Optional — Unsplash Search API fills remaining gallery slots after Wikimedia
UNSPLASH_ACCESS_KEY=

ASSEMBLY_FEE_RATE=0.08
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AirportDB ICAO lookup fallback (https://airportdb.io/)
# Sign up → create a token. Keep server-side only — never expose to the client.
# Note: AirportDB has no city/IATA search; autocomplete uses OurAirports data
# (same source). Refresh with: node scripts/sync-airports.mjs
AIRPORTDB_API_TOKEN=
